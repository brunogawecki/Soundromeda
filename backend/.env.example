# Soundromeda backend — copy to .env and adjust as needed.
# All keys are optional; defaults are shown.

# SOUNDROMEDA_APP_NAME=Soundromeda
# SOUNDROMEDA_DEBUG=false

# Database (default: SQLite in backend root)
# SOUNDROMEDA_DATABASE_URL=sqlite+aiosqlite:///./soundromeda.db

# Paths (relative to backend root unless absolute)
# SOUNDROMEDA_STATIC_DIR=static
# SOUNDROMEDA_BACKEND_ROOT=
# SOUNDROMEDA_DEFAULT_AUDIO_SOURCE=Neptunes Drumkit
# SOUNDROMEDA_AUDIO_EXTENSIONS=.wav,.WAV,.mp3,.ogg,.flac,.m4a,.aac

# CORS (comma-separated origins)
# SOUNDROMEDA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max duration (seconds) for a single audio sample; longer files are rejected/skipped
# SOUNDROMEDA_MAX_SAMPLE_DURATION_SEC=5.0
